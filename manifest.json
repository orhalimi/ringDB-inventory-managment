{
  "manifest_version": 3,
  "name": "LOTR Inventory Manager",
  "description": "Track your physical LOTR LCG collection and detect card conflicts across active decks.",
  "version": "0.2",
  "permissions": ["storage"],
  "host_permissions": ["https://ringsdb.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "LOTR Inventory Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://ringsdb.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/dexie.mjs"],
      "matches": ["https://ringsdb.com/*"]
    }
  ]
}
